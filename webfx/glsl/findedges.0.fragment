precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float smoothing;
uniform float threshold;
uniform bool invert;



        const vec3 luminanceWeighting = vec3(0.2126, 0.7152, 0.0722);

        void main() {

            vec2 st = acScreenNorm;
            vec2 fragSize = vec2(1.)/getTexSize(__sz_inputImg) * smoothing;
            float w  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x - fragSize.x, acScreenNorm.y) ).rgb*luminanceWeighting);
            float e  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x + fragSize.x, acScreenNorm.y) ).rgb*luminanceWeighting);
            float n  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x, acScreenNorm.y + fragSize.y) ).rgb*luminanceWeighting);
            float s  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x, acScreenNorm.y - fragSize.y) ).rgb*luminanceWeighting);
            float nw  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x - fragSize.x, acScreenNorm.y + fragSize.y) ).rgb*luminanceWeighting);
            float ne  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x + fragSize.x, acScreenNorm.y + fragSize.y) ).rgb*luminanceWeighting);
            float sw  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x - fragSize.x, acScreenNorm.y - fragSize.y) ).rgb*luminanceWeighting);
            float se  = dot(vec3(1.),texture2DCv(inputImg, vec2(acScreenNorm.x + fragSize.x, acScreenNorm.y - fragSize.y) ).rgb*luminanceWeighting);
            //mat3 m = mat3( nw, n, ne,
            //               w, 0., e,
            //               sw, s, se );
            //mat3 v = mat3( 3., 10., 3.,
            //               0., 0., 0.,
            //               -3., -10., -3.);
            //mat3 h = mat3( -3., 0., 3.,
            //               -10., 0., 10.,
            //               -3., 0., 3.);

            float v = nw * 3. + n * 10. + ne * 3. + sw * -3. + s * -10. + se * -3.;
            float h = nw * -3. + w * -10. + sw * -3. + ne * 3. + e * 10. + se * 3.;
            float g = clamp(sqrt(h*h + v*v)-threshold, 0., 1.);

            vec4 texColor = texture2DCv(inputImg, acScreenNorm);

            if( invert ) {
                gl_FragColor = vec4(g,g,g,1.) * texColor;
            } else {
                gl_FragColor = vec4(1.-g,1.-g,1.-g,1.) * texColor.a;
            }

        }

    