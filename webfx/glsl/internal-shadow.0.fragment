precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform sampler2D downImg; uniform vec2 __sz_downImg;
uniform sampler2D hblur; uniform vec2 __sz_hblur;
uniform float sigma;
uniform float sdx;
uniform float sdy;
uniform vec4 color;
uniform float alpha;



        #define MULTISAMPLE 1.0

        vec4 blurInternal(sampler2D texture, vec2 texOffset, vec2 st, float rate)
        {
            if(sigma <= 0.0) {
                if(st.x >= 0.0 && st.x <= 1.0 && st.y >= 0.0 && st.y <= 1.0)
                    return texture2DCv(texture,st).rgba;
                else
                    return vec4(0, 0, 0, 0);
            }
            const float PI = 3.14159265;
            //To get gauss(x) <= gauss(0)*0.1
            //x>=sigma*sqrt(2*ln10) = 2.14596602...
            //If you want to get gauss(x) <= gauss(0)*0.01 to get more dedicated result,
            //x>=2.0*sigma*sqrt(ln10) = 3.03485425....
            //currently, in my thought, 0.1 of the center pixel will be enough.
            float adjSigma = sigma * rate;
            float numBlurPixelsPerSide = (2.14596602 * adjSigma);


            highp vec3 incrementalGaussian;
            incrementalGaussian.x = 1.0 / (sqrt(2.0 * PI) * adjSigma);
            incrementalGaussian.y = exp(-0.5 / (adjSigma * adjSigma));
            incrementalGaussian.z = incrementalGaussian.y * incrementalGaussian.y;

            vec4 avgValue = vec4(0.0, 0.0, 0.0, 0.0);
            highp float coefficientSum = 0.0;

            if(st.x >= 0.0 && st.x <= 1.0 && st.y >= 0.0 && st.y <= 1.0)
                avgValue += (texture2DCv(texture,st).rgba * incrementalGaussian.x);
            coefficientSum += incrementalGaussian.x;

            for (float i = 1.0; i <= numBlurPixelsPerSide; i += 2.0) {

                float offset0 = i;
                float offset1 = i + 1.0;

                incrementalGaussian.xy *= incrementalGaussian.yz;
                coefficientSum += (2.0 * incrementalGaussian.x);
                float weight0 = incrementalGaussian.x;
                incrementalGaussian.xy *= incrementalGaussian.yz;
                coefficientSum += (2.0 * incrementalGaussian.x);
                float weight1 = incrementalGaussian.x;
                float weightL = weight0 + weight1;
                float offsetL = (offset0*weight0 + offset1*weight1) / weightL;
                vec2 stL = st - offsetL * texOffset;
                vec2 stR = st + offsetL * texOffset;
                if(stL.x >= 0.0 && stL.x <= 1.0 && stL.y >= 0.0 && stL.y <= 1.0)
                    avgValue += (texture2DCv(texture, stL) * weightL);
                if(stR.x >= 0.0 && stR.x <= 1.0 && stR.y >= 0.0 && stR.y <= 1.0)
                    avgValue += (texture2DCv(texture, stR) * weightL);
            }

            return avgValue / coefficientSum;
        }
        void main() {
            if( acPass == 0 ) {
                gl_FragColor = texture2DCv(inputImg, acScreenNorm.st);
            }
            else if( acPass==1 ) {
                vec2 texOffset = vec2(1.0/acProjectSize.x, 0.0);
                gl_FragColor = blurInternal(downImg, texOffset, vec2(acScreenNorm.s - sdx*(texOffset.x/MULTISAMPLE),acScreenNorm.t), 0.5);
            } else {
                vec2 texOffset = vec2(0.0, 1.0/acProjectSize.y);
                vec4 result = blurInternal(hblur, texOffset, vec2(acScreenNorm.s, acScreenNorm.t + sdy*(texOffset.y/MULTISAMPLE)), 0.5);
                vec4 original = texture2DCv(inputImg,acScreenNorm.st);
                result = original + color*result.a*alpha*(1.0-original.a);
                gl_FragColor = result;
            }
        }
