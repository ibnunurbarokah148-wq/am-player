precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float offset;
uniform float radius;
uniform int curlFrom;
uniform int curlDirection;
uniform float stretch;



        #define PI 3.1415926536

        vec2 l2s( vec2 v ) {
            return (vec4(v,0.,1.)*acLayerToScreen).xy;
        }

        void main() {
            //vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            vec2 st = acLayerNorm;
            //st.x *= acLayerSize.x/acLayerSize.y;

            vec2 adjCenter;// = center/1000.;
            if( curlDirection==0 ) {
                adjCenter = vec2(offset,-radius);
            } else {
                adjCenter = vec2(offset,1.+radius);
            }
            adjCenter.y = 1.-adjCenter.y;

            vec2 dd = st-adjCenter;
            dd.x *= acLayerSize.x/acLayerSize.y;

            float circ = 2. * PI * radius / (acLayerSize.x/acLayerSize.y) * stretch;
            float a = 0.5 - (atan(dd.x,dd.y) / (2. * PI));
            float r = length(dd);

            //bool top = (origin==0 || origin==1);
            //bool right = (origin==1 || origin==3);
            bool top = (curlDirection==1); // (center.y>=500.);
            bool right = (curlFrom==0);

            float cline = smoothstep(1.0-(2./acLayerSize.y),1.0,1.-abs(radius-length(dd)));

            if( top ) {
                float topY = adjCenter.y + radius;
                a = mod(a - 0.500,1.);
                float arcDist = a*circ;
                if( right ) {
                    vec2 v = vec2(adjCenter.x-(arcDist),topY+(r-radius));

                    if( st.x < adjCenter.x || st.y < topY ) {
                        st = v;
                    }
                } else {
                    vec2 v = vec2((circ-arcDist+adjCenter.x),topY+(r-radius));

                    if( st.x > adjCenter.x || st.y < topY ) {
                        st = v;
                    }
                }
            } else {
                float bottomY = adjCenter.y - radius;
                float arcDist = a*circ;
                if( right ) {
                    vec2 v = vec2(adjCenter.x-(circ-arcDist),bottomY-(r-radius));

                    if( st.x < adjCenter.x || st.y > bottomY ) {
                        st = v;
                    }
                } else {
                    vec2 v = vec2(arcDist+adjCenter.x,bottomY-(r-radius));

                    if( st.x > adjCenter.x || st.y > bottomY ) {
                        st = v;
                    }
                }
            }

            float inside = step(0.,st.x) * step(st.x,1.) * step(0.,st.y) * step(st.y,1.) * step(radius,r);

            vec4 result = texture2DCv(inputImg,l2s(st))*inside;
            vec4 circleColor = vec4(0.2,0.6,0.9,1.0);
            float circleAlpha = acShowGuides?0.5:0.0;
            gl_FragColor = mix(result,circleColor,cline*circleAlpha);
        }

    