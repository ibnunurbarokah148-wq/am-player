precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform vec2 start;
uniform vec2 end;
uniform float evolution;
uniform float seed;
uniform vec4 color1;
uniform vec4 color2;
uniform vec4 color3;
uniform float limit;
uniform float intensity;
uniform float glow;
uniform float core;
uniform float alpha;
uniform float count;
uniform float octaves;
uniform bool smooth;
uniform int blendMode;




        float sdLine( in vec2 p, in vec2 a, in vec2 b )
        {
            vec2 pa = p-a, ba = b-a;
            float h = clamp( dot(pa,ba)/dot(ba,ba), 0.0, 1.0 );
            return length( pa - ba*h );
        }

        vec2 projectAndClamp(vec2 a, vec2 b) {
            return clamp(dot(a,b)/dot(b,b),0.0,1.0) * b;
        }

        // 2D Random
        float random (vec2 st) {
            return fract(sin(dot(st.xy,
                                 vec2(12.9898,78.233)))
                         * 43758.5453123);
        }

        // 2D Noise based on Morgan McGuire @morgan3d
        // https://www.shadertoy.com/view/4dS3Wd
        float noise (vec2 st) {
            vec2 i = floor(st);
            vec2 f = fract(st);

            // Four corners in 2D of a tile
            float a = random(i);
            float b = random(i + vec2(1.0, 0.0));
            float c = random(i + vec2(0.0, 1.0));
            float d = random(i + vec2(1.0, 1.0));

            // Interpolation
            vec2 u;
            if(smooth){
                // Cubic Hermine Curve.  Same as SmoothStep()
                //u = f*f*(3.0-2.0*f);
                u = smoothstep(0., 1., f);
            } else {
                // Jagged noise for lightning
                u = f;
            }

            // Mix 4 coorners percentages
            return mix(a, b, u.x) +
                    (c - a)* u.y * (1.0 - u.x) +
                    (d - b) * u.x * u.y;
        }

        //float xnoise(vec2 st) {
        //    float n = noise(st);
        //    n = abs(n);
        //    n = 0.9-n;
        //    n = n*n;
        //    n = mod(n,1.) * 2. - 1.;
        //    return n;
        //}

        float fractNoise (vec2 st, int octaves) {
            st *= 4.;
            float result = noise(st);
            if ( octaves >= 2.0 )
                result += noise(st*2.)*0.5;
            if ( octaves >= 3.0 )
                result += noise(st*4.)*0.3;
            if ( octaves >= 4.0 )
                result += noise(st*8.)*0.2;
            if ( octaves >= 5.0 )
                result += noise(st*16.)*0.1;
            return result;
        }


        vec2 l2s( vec2 v, mat4 acLTS ) {
            return (vec4(v,0.,1.)*acLTS).xy;
        }

        vec3 lightning( vec2 st, vec2 a, vec2 b, float scale, float seed, float width, float limit ) {

            vec2 ab = b - a;
            vec2 n = normalize(ab).yx;
            n.y *= -1.;

            vec2 p = projectAndClamp(st-a, ab)+a;
            float t = distance(p,a)/distance(b,a);
            float f = smoothstep(0.,0.5,0.5-abs(t-0.5));

            st += n*(fractNoise(vec2(t,seed),int(octaves))-1.)* scale * 0.3 * length(ab)*f;

            //float c = sdLine(st,a,b);
            float c = length(st - p);
            float l = smoothstep(clamp(limit,0.,0.5)-0.5, .5, abs(0.5-t));
            float xl = clamp(limit-0.5, 0., 1.);
            l = l * (1. - xl) + xl;
            return vec3(smoothstep(0.006*width*core,0.,c),smoothstep(0.034*width,-0.032,c),smoothstep(0.034*width*glow,0.,c)) * l;
        }


        void main() {
            vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            vec2 st = acLayerNorm;
            st -= 0.5;
            st.x *= acLayerSize.x/acLayerSize.y;

            vec3 lcolor = vec3(0.);

            float adjseed = mod(258.35 + 42.78*seed,138.971);
            float w = 0.1;
            float slimit = 0.2;

            vec2 a = start / 1000.;
            vec2 b = end / 1000.;

            a.y *= -1.;
            b.y *= -1.;

            int icount = int(count);
            for( int i=0; i<icount; i++ ) {
                w += 0.2;
                slimit += 7.4;
                adjseed = mod(adjseed * sin(adjseed+1.2)+4.3,45.32);
                lcolor += lightning(st,a,b, 1., evolution+adjseed, pow((noise(vec2(w,evolution))+1.)/2.,1.584), pow((noise(vec2(slimit,evolution))*limit+1.)/2.584,1.584)) * intensity;
            }

            //if( tint.r >= tint.g && tint.g >= tint.b ) {
            //} else if( tint.r >= tint.b && tint.b >= tint.g ) {
            //}

            //vec4 color = vec4(lcolor,max(max(lcolor.r,lcolor.g),lcolor.b));

            vec4 color = ((color1 * lcolor.r) + (color2 * lcolor.g) + (color3 * lcolor.b)) / 3.;  // max(1., lcolor.r + lcolor.g + lcolor.b);

            color *= alpha;

            vec4 result;
            if( blendMode==0 ) {                // normal
                color *= texColor.a;
                result = color + (texColor*(1.0-color.a));
            } else if( blendMode==1 ) {         // multiply
                vec4 c = color + vec4(1.)*(1.-color.a);
                result = vec4((texColor.rgb/texColor.a)*c.rgb,1.0) * texColor.a;
            } else if( blendMode==2 ) {         // screen
                result = vec4( 1.-((1.-(texColor.rgb/texColor.a))*(1.-color.rgb)),1.0) * texColor.a;
            //} else if( blendMode==3 ) {         // overflow
            //    result = color;
            } else if( blendMode==4 ) {         // punchout
                result = texColor * (1.0-color.a);
            } else if( blendMode==6 ) {         // sourceonly
                result = color;
            } else if( blendMode==5 ) {         // overlay
                vec3 top = color.rgb / color.a;
                vec3 bot = texColor.rgb / texColor.a;
                vec3 t = smoothstep(0.5,0.5,bot);
                vec3 r3 =
                        t * (1. - (1.-2.*(bot-0.5)) * (1.-top)) +
                        (1.-t) * ((2.*bot) * top);
                vec4 r4 = vec4(r3, 1.0) * color.a * texColor.a;
                result = texColor * (1.-r4.a) + r4;
            }

            gl_FragColor = result;

        }

    