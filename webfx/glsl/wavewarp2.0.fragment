precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float phase;
uniform float a1d;
uniform float m1;
uniform float m2;
uniform float a2d;
uniform float damping;
uniform float dampingSpace;
uniform float dampingOrigin;
uniform bool screenSpace;



        void main() {

            float a1 = a1d * 0.0174533;
            float a2 = (a1d+a2d) * 0.0174533;

            vec2 st;
            if( screenSpace ) {
                st = acScreenNorm;
            } else {
                st = acLayerNorm;
            }

            vec2 raw_v = vec2(cos(a1),-sin(a1));
            float raw_p = dot(st,raw_v);
            float space_damp = 1.0;
            if( dampingSpace < 0.0 ) {
                space_damp = 1.0 - ( clamp(abs(raw_p-dampingOrigin),0.0,1.0) * (0.0-dampingSpace));
            } else if( dampingSpace > 0.0 ) {
                space_damp = 1.0 - ( (1.0 - clamp(abs(raw_p-dampingOrigin),0.0,1.0) ) * dampingSpace);
            }

            float space = m1 * space_damp;

            vec2 v = vec2(cos(a1),-sin(a1)) * space;
            float p = dot(st,v);

            float ddist = abs(p/space);

            float damp = 1.0;
            if( damping < 0.0 ) {
                damp = 1.0 - ( clamp(abs(ddist-dampingOrigin),0.0,1.0) * (0.0-damping));
            } else if( damping > 0.0 ) {
                damp = 1.0 - ( (1.0 - clamp(abs(ddist-dampingOrigin),0.0,1.0) ) * damping);
            }

            vec2 offs = vec2(cos(a2),-sin(a2)) * (m2*damp)/100.0;
            offs *= sin(p+phase*6.28318);

            //if( !screenSpace ) {
            //    st = (vec4(st,0.0,1.0) * acLayerToScreen).xy;
            //}
            vec4 texColor = texture2DCv(inputImg, acScreenNorm+offs);
            gl_FragColor = texColor; //vec4(ddist*texColor.a,texColor.gba);


            //mat2 rot = mat2(
            //    cos(a), -sin(a),
            //    sin(a), cos(a)
            //);
            //
            //vec2 st = acLayerNorm;
            //st += sin((st*rot).y*freq+phase)*mag;
            //gl_FragColor = texture2DCv(inputImg,(vec4(st,0.0,1.0)*acLayerToScreen).xy);

        }

    