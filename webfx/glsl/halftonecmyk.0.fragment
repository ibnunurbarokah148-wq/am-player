precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float amount;
uniform float strength;
uniform float blackWeight;
uniform float angle;
uniform float phase;



        const vec3 luminanceWeighting = vec3(0.2126, 0.7152, 0.0722);

        float halftone(float a, vec4 mask) {

            float rad = a * 0.0174533;
            mat2 rot = mat2(cos(rad),-sin(rad),sin(rad),cos(rad));
            mat2 invrot = mat2(cos(-rad),-sin(-rad),sin(-rad),cos(-rad));

            vec2 st = acScreenNorm;

            st -= acLayerCenterNorm;
            st.y *= (acScreenSize.y/acScreenSize.x);
            st *= rot;

            // Y Distance

            float distY = mod(st.y*amount,1.);

            if( distY < 0.5 ) {
                distY = -distY;
            } else {
                distY = 1.0-distY;
            }

            float absDistY = abs(distY);

            distY /= amount;

            // X Distance

            float xoffs = step(1.,mod(st.y*amount+0.5,2.)) * phase;

            float distX = mod(st.x*amount+xoffs,1.);

            if( distX < 0.5 ) {
                distX = -distX;
            } else {
                distX = 1.0-distX;
            }

            float absDistX = abs(distX);

            distX /= amount;

            // Sampling

            st.y += distY;
            st.x += distX;

            st *= invrot;
            st.y /= (acScreenSize.y/acScreenSize.x);
            st += acLayerCenterNorm;

            vec4 samp = texture2DCv(inputImg,st);

            // CMYK

            float k = min(1.-samp.r, min(1.-samp.g, 1.-samp.b)) * blackWeight;
            float c = k>=1.0 ? 0.0 : ((1.0 - samp.r) - k) / (1.0-k);
            float m = k>=1.0 ? 0.0 : ((1.0 - samp.g) - k) / (1.0-k);
            float y = k>=1.0 ? 0.0 : ((1.0 - samp.b) - k) / (1.0-k);

            vec4 cmyk = vec4(c,m,y,k);

            float lum = length(cmyk*mask) / length(mask);

            float dist = length(vec2(absDistX,absDistY));
            float radius = strength*2.0;

            float mag = max(0., radius-dist);

            float p = smoothstep( 0.4,0.6, mag*lum) * samp.a;

            return p;
        }

        void main() {

            float c = halftone(angle+15., vec4(1., 0., 0., 0.));
            float m = halftone(angle+75., vec4(0., 1., 0., 0.));
            float y = halftone(angle+0., vec4(0., 0., 1., 0.));
            float k = halftone(angle+45., vec4(0., 0., 0., 1.));

            vec4 texColor = texture2DCv(inputImg,acScreenNorm);

            vec4 outColor = vec4(1.-c-k, 1.-m-k, 1.-y-k, 1.) * texColor.a;

            gl_FragColor = outColor;

        }

    