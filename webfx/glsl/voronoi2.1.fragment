precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float scale;
uniform float phase;
uniform float lineWidth;
uniform vec4 color;
uniform vec4 color2;
uniform vec4 lineColor;
uniform float seed;



        float random (in vec2 st) {
            return fract(sin(dot(st.xy,
                                 vec2(12.9898,78.233)))*
                43758.5453123);
        }

        vec2 rand2v(vec2 co) {
            return vec2(random(co),random(co+vec2(361.312,173.019)));
        }

        void main() {
            vec4 texColor = texture2DCv(inputImg,acScreenNorm);

            vec2 st = acLayerNorm.st;
            st.x *= acLayerSize.x/acLayerSize.y;
            st -= vec2(0.5,0.5);

            st /= (scale*0.07);

            vec2 tile = floor(st);
            vec2 tpart = fract(st);

            float maxDist = 100.0;
            vec2 nearestTile = vec2(0.0,0.0);
            vec2 nearestTileOffs = vec2(0.0,0.0);
            vec2 nearest_r = vec2(0.0,0.0);


            float actualPhase = phase * 6.28318;

            vec2 seedVec = vec2(123.215,272.055)*seed;

            for( int i=-1; i<=1; i++ ) {
                for( int j=-1; j<=1; j++ ) {
                    vec2 checkTileOffs = vec2(float(i),float(j));
                    vec2 p = rand2v(tile + checkTileOffs + seedVec);
                    p = 0.5 + 0.5*sin(actualPhase + 6.2831*p);
                    vec2 r = checkTileOffs + p - tpart;
                    float dist = dot(r,r);
                    if( dist < maxDist ) {
                        maxDist = dist;
                        //nearest_k = float(k);
                        nearest_r = r;
                        nearestTile = checkTileOffs + tile;
                        nearestTileOffs = checkTileOffs;
                    }
                }
            }

            float actualMaxDist = 100.0;
            for( int i=-2; i<=2; i++ ) {
                for( int j=-2; j<=2; j++ ) {
                    vec2 checkTileOffs = nearestTileOffs + vec2(float(i),float(j));
                    vec2 p = rand2v(tile + checkTileOffs + seedVec);
                    p = 0.5 + 0.5*sin(actualPhase + 6.2831*p);
                    vec2 r = checkTileOffs + p - tpart;
                    if( dot(nearest_r-r,nearest_r-r) > 0.00001 ) {
                        float dist = dot(0.5*(nearest_r+r), normalize(r-nearest_r));
                        actualMaxDist = min(dist,actualMaxDist);
                    }
                }
            }

            float colorPct =  random(nearestTile + vec2(721.117,433.215)*seed);

            vec4 result = mix(color,color2,colorPct); // * actualMaxDist;

            vec4 line = lineWidth<0.00001 ? vec4(0.0) : lineColor * (1.0-smoothstep(lineWidth-0.02,lineWidth+0.001,actualMaxDist));

            //result = vec4(actualMaxDist,abs(actualMaxDist),0.5,1.0);

            result = line + ((1.0-line.a)*result);

            result = result * texColor.a;

            gl_FragColor = result;
        }

    