precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float size;
uniform float stretch;
uniform vec2 offset;
uniform float angle;
uniform float vignette;
uniform bool screenSpace;
uniform float threshold;
uniform float saturation;



        mat2 rot(float a) {
            float c = cos(a);
            float s = sin(a);
            return mat2(
                c, -s,
                s, c
            );
        }

        void main() {
        
            vec2 sizeVec = vec2(size,size);
            if( stretch > 0.0 ) {
                sizeVec.x *= 1.0 + (stretch/5.0);
            } else if( stretch < 0.0 ) {
                sizeVec.y *= 1.0 - (stretch/5.0);
            }
            
            vec2 pixelSize = sizeVec / acScreenSize;
            vec2 st = acScreenNorm;
            if( !screenSpace )
                st -= acLayerCenterNorm;
            st *= rot(angle * 0.0174533);
            st -= offset/1000.0;
            vec2 posInPixel = mod(st,pixelSize);
            posInPixel -= pixelSize/2.0;
            posInPixel *= rot(-angle * 0.0174533);
            posInPixel += pixelSize/2.0;
            vec2 pixelCenter = acScreenNorm - posInPixel + pixelSize / 2.0;

            float distCenter = smoothstep(0.0, 1.0, length((posInPixel/pixelSize) - vec2(0.5,0.5)));

            vec4 color = texture2DCv(inputImg,pixelCenter);
            float tclamp = step(threshold, color.a);
            if( color.a > 0.0 && saturation > 0.0 ) {
                color /= color.a / max(color.a,saturation);
            }
            color = color * tclamp;
            //color = mix(color, vec4(0.0,0.0,0.0,color.a), vignette * distCenter);
            color = mix(color, vec4(min(color.rgb * color.rgb * color.rgb, vec3(0.9, 0.9, 0.9)),color.a * color.a * color.a), step(1.5, size) * vignette * distCenter);
            //color = vec4(color.rgb * (1.0-(vignette*distCenter)), color.a);
            gl_FragColor = color;
        }

    