precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform vec2 position;
uniform float size;
uniform float stretch;
uniform float lineWidth;
uniform float feather;
uniform float angle;
uniform bool maskToLayer;
uniform float texCrop;
uniform float texTwirl;
uniform int edges;
uniform bool screenSpace;



        const float PI = 3.14159;
        const float ulp = PI/240.;

        const vec2 hexRatio = vec2(1.0, 1.73);
        const vec2 hexRatioNorm = normalize(hexRatio);

        float hexDist(vec2 p) {
            return max(dot(abs(p), hexRatioNorm), abs(p.x));
        }

        void hexTile(vec2 st, out vec2 uv, out vec2 huv, out vec2 id) {
            vec2 grid = mod(st, hexRatio)-hexRatio/2.;
            vec2 offsetGrid = mod(st-hexRatio/2., hexRatio)-hexRatio/2.;
            uv = length(grid) < length(offsetGrid) ? grid : offsetGrid;
            huv = vec2(atan(uv.x, uv.y), (.5-hexDist(uv))*2.);
            id = vec2(st.x-uv.x, st.y-uv.y);
        }

        mat2 rot(float a) {
            float c = cos(a);
            float s = sin(a);
            return mat2(
                c, -s,
                s, c
            );
        }

        vec2 l2s( vec2 v, mat4 acLTS ) {
            return (vec4(v,0.,1.)*acLTS).xy;
        }


        void main() {
            //vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            vec2 st;
            if(screenSpace) {
                st = acScreenNorm;
                st -= 0.5;
                st.x *= acScreenSize.x/acScreenSize.y;
            } else {
                st = acLayerNorm;
                st -= 0.5;
                st.x *= acLayerSize.x/acLayerSize.y;
            }

            vec2 scale = vec2(size/100., size/100. * stretch);
            vec2 pos = (position/500.) * vec2(1., -1.);

            st /= scale;

            st *= rot(angle * 0.0174533);

            pos *= rot(-angle * 0.0174533);

            vec2 modPos = mod(pos,hexRatio*2.);
            vec2 basePos = pos - modPos;
            vec2 stepPos = basePos;// hexRatio;
            st -= modPos;

            vec2 uv;
            vec2 huv;
            vec2 id;
            hexTile(st,uv,huv,id);

            id -= stepPos;// * vec2(1.,-1.);
            id += 1000.;

            //vec2 screenCoord;
            //screenCoord = st-uv;
            //screenCoord += modPos;
            //screenCoord *= rot(-angle * 0.0174533);
            //screenCoord *= scale;
            //screenCoord.x /= acLayerSize.x/acLayerSize.y;
            //screenCoord += 0.5;
            //screenCoord = l2s(screenCoord,acLayerToScreen);
            //vec4 centerColor = texture2DCv(inputImg,screenCoord);

            float pp = lineWidth;
            //if( alphaScale ) {
            //    pp = max(1. - centerColor.a, lineWidth);
            //} else if (blendMode == 3) {
            //    pp = max(1. - step(0.001,centerColor.a), lineWidth);
            //} else {
            //    pp = lineWidth;
            //}
            //float p = smoothstep(pp,pp+(1.0-pp)*feather,huv.y);
            pp = ((pp-0.5) * (1.0+feather)) + 0.5;
            //pp *= 1.0 - feather;
            //pp += feather / 2.;
            float p = smoothstep(pp-feather/2.,pp+feather/2.,huv.y);

            vec4 color;

            float texTwirlRad = texTwirl * 0.0174533;
            float texTwirlCos = cos(texTwirlRad);
            float texTwirlSin = sin(texTwirlRad);
            mat2 texTwirlRot = mat2( texTwirlCos, -texTwirlSin, texTwirlSin, texTwirlCos );

            uv *= texCrop; // 1.25;
            uv *= texTwirlRot;
            uv.x /= acLayerSize.x/acLayerSize.y;
            if( edges == 3 ) {
                uv += 0.5;
                uv = mod(uv,vec2(1.0));
                uv -= 0.5;
                uv *= 1. - 2./min(acLayerSize.x,acLayerSize.y);
            }
            uv += 0.5;

            uv = l2s(uv,acLayerToScreen);

            color = texture2DCv(inputImg,uv);

            //vec4 c = color * p;

            if( maskToLayer ) {
                p *= texture2DCv(inputImg,acScreenNorm).a;
            }

            color *= p;

            //if( copyAlpha ) {
            //    color *= centerColor.a;
            //}

            //vec4 result;
            //if( blendMode==0 ) {                // normal
            //    color *= texColor.a;
            //    result = color + (texColor*(1.0-color.a));
            //} else if( blendMode==1 ) {         // multiply
            //    vec4 c = color + vec4(1.)*(1.-color.a);
            //    result = vec4((texColor.rgb/texColor.a)*c.rgb,1.0) * texColor.a;
            //} else if( blendMode==2 ) {         // screen
            //    result = vec4( 1.-((1.-(texColor.rgb/texColor.a))*(1.-color.rgb)),1.0) * texColor.a;
            //} else if( blendMode==3 ) {         // overflow
            //    result = color;
            //} else if( blendMode==4 ) {         // punchout
            //    result = texColor * (1.0-p);
            //} else if( blendMode==5 ) {         // overlay
            //    vec3 top = color.rgb / color.a;
            //    vec3 bot = texColor.rgb / texColor.a;
            //    vec3 t = smoothstep(0.5,0.5,bot);
            //    vec3 r3 =
            //            t * (1. - (1.-2.*(bot-0.5)) * (1.-top)) +
            //            (1.-t) * ((2.*bot) * top);
            //    vec4 r4 = vec4(r3, 1.0) * color.a * texColor.a;
            //    result = texColor * (1.-r4.a) + r4;
            //}

            gl_FragColor = color;

        }

    