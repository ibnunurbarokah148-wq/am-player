precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform sampler2D comp; uniform vec2 __sz_comp;
uniform vec2 offs;
uniform int typex;
uniform int typey;
uniform int edges;
uniform bool fromctr;
uniform bool invert;



        const vec3 luminanceWeighting = vec3(0.2126, 0.7152, 0.0722);

        void main() {

            vec2 adjOffs = offs / 1000.0;
            adjOffs.x *= acLayerSize.x/acLayerSize.y * -1.0;
            vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            float luminance = dot(texColor.rgb, luminanceWeighting);
            float px;
            float py;

            if( typex==0 ) {
                px = luminance;
            } else if( typex == 1 ) {
                px = texColor.r;
            } else if( typex == 2 ) {
                px= texColor.g;
            } else if( typex == 3 ) {
                px = texColor.b;
            } else {
                adjOffs *= 0.0;
            }

            if( typey==0 ) {
                py = luminance;
            } else if( typey == 1 ) {
                py = texColor.r;
            } else if( typey == 2 ) {
                py= texColor.g;
            } else if( typey == 3 ) {
                py = texColor.b;
            } else {
                adjOffs *= 0.0;
            }

            if( fromctr ) {
                px = (px-0.5)*2.0;
                py = (py-0.5)*2.0;
            }
            if( invert ) {
                px = 1.0-px;
                py = 1.0-py;
            }

            vec2 p = vec2(px,py);

            adjOffs *= p * texColor.a;

            vec2 sample = acScreenNorm + adjOffs;
            if(edges==0) {
                gl_FragColor = texture2DCv(comp,sample);
            } else if(edges==1) {
                sample = vec2(1.0,1.0) - abs(mod(sample,vec2(2.0,2.0))-vec2(1.0,1.0));
                gl_FragColor = texture2DCv(comp,sample) * texColor.a;
            } else if(edges==2) {
                if( sample.x < 0.0 || sample.x > 1.0 || sample.y < 0.0 || sample.y > 1.0 ) {
                    gl_FragColor = vec4(0.0,0.0,0.0,0.0);
                } else {
                    gl_FragColor = texture2DCv(comp,sample) * texColor.a;
                }
            } else if(edges==3) {
                sample = mod(sample,vec2(1.0,1.0));
                gl_FragColor = texture2DCv(comp,sample) * texColor.a;
            } else {
                gl_FragColor = texture2DCv(comp,sample) * texColor.a;
            }

        }

    