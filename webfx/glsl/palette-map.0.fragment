precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform int palette;
uniform float alpha;
uniform vec4 color1;
uniform vec4 color2;
uniform vec4 color3;
uniform vec4 color4;
uniform vec4 color5;
uniform vec4 color6;
uniform vec4 color7;
uniform vec4 color8;
uniform float shades;



        void main() {

            // 0xFF = 255 = 1.000
            // 0x55 =  85 = 0.333
            // 0xAA = 170 = 0.667

            vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            float a = texColor.a;
            vec3 rgb = texColor.rgb / max(0.0001,a);

            vec3 c[16];
            int ncolors;

            if( palette == 0 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.333, 1.000, 0.333);
                c[2] = vec3(1.000, 0.333, 0.333);
                c[3] = vec3(1.000, 1.000, 0.333);
                ncolors = 4;
            } else if( palette == 1 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.333, 1.000, 1.000);
                c[2] = vec3(1.000, 0.333, 1.000);
                c[3] = vec3(1.000, 1.000, 1.000);
                ncolors = 4;
            } else if( palette == 10 ) {
                c[0] = vec3(0.333, 0.333, 1.000);
                c[1] = vec3(0.333, 1.000, 1.000);
                c[2] = vec3(1.000, 0.333, 1.000);
                c[3] = vec3(1.000, 1.000, 1.000);
                ncolors = 4;
            } else if( palette == 2 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.000, 0.000, 0.667);
                c[2] = vec3(0.000, 0.667, 0.000);
                c[3] = vec3(0.000, 0.667, 0.667);
                c[4] = vec3(0.667, 0.000, 0.000);
                c[5] = vec3(0.667, 0.000, 0.667);
                c[6] = vec3(0.667, 0.333, 0.000);
                c[7] = vec3(0.667, 0.667, 0.667);

                c[8]  = vec3(0.333, 0.333, 0.333);
                c[9]  = vec3(0.333, 0.333, 1.000);
                c[10] = vec3(0.333, 1.000, 0.333);
                c[11] = vec3(0.333, 1.000, 1.000);
                c[12] = vec3(1.000, 0.333, 0.333);
                c[13] = vec3(1.000, 0.333, 1.000);
                c[14] = vec3(1.000, 1.000, 0.333);
                c[15] = vec3(1.000, 1.000, 1.000);
                ncolors = 16;
            } else if( palette == 3 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.000, 0.000, 0.667);
                c[2] = vec3(0.000, 0.667, 0.000);
                c[3] = vec3(0.333, 0.667, 1.000);
                c[4] = vec3(0.667, 0.000, 0.000);
                c[5] = vec3(0.667, 0.000, 0.667);
                c[6] = vec3(0.333, 0.667, 0.000);
                c[7] = vec3(0.667, 0.667, 0.667);

                c[8]  = vec3(0.333, 0.333, 0.333);
                c[9]  = vec3(0.333, 0.333, 1.000);
                c[10] = vec3(0.333, 1.000, 0.333);
                c[11] = vec3(0.333, 1.000, 1.000);
                c[12] = vec3(1.000, 0.333, 0.333);
                c[13] = vec3(1.000, 0.333, 1.000);
                c[14] = vec3(1.000, 1.000, 0.333);
                c[15] = vec3(1.000, 1.000, 1.000);
                ncolors = 16;
            } else if( palette == 4 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.333, 0.333, 1.000);
                c[2] = vec3(0.333, 1.000, 0.333);
                c[3] = vec3(0.333, 1.000, 1.000);
                c[4] = vec3(1.000, 0.333, 0.333);
                c[5] = vec3(1.000, 0.333, 1.000);
                c[6] = vec3(1.000, 1.000, 0.333);
                c[7] = vec3(1.000, 1.000, 1.000);
                ncolors = 8;
            } else if( palette == 5 ) {
                c[0] = vec3(0.000, 0.000, 0.000);
                c[1] = vec3(0.333, 0.333, 0.333);
                c[2] = vec3(0.667, 0.667, 0.667);
                c[3] = vec3(1.000, 1.000, 1.000);
                ncolors = 4;
            } else if( palette == 6 && shades) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[4] = color1.rgb * 0.667;
                c[5] = color2.rgb * 0.667;
                c[6] = color3.rgb * 0.667;
                ncolors = 6;
            } else if( palette == 6 ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                ncolors = 3;
            } else if( palette == 7 && shades ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                c[4] = color1.rgb * 0.667;
                c[5] = color2.rgb * 0.667;
                c[6] = color3.rgb * 0.667;
                c[7] = color4.rgb * 0.667;
                ncolors = 8;
            } else if( palette == 7 ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                ncolors = 4;
            } else if( palette == 8 && shades ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                c[4] = color5.rgb;
                c[5] = color6.rgb;
                c[6] = color1.rgb * 0.667;
                c[7] = color2.rgb * 0.667;
                c[8] = color3.rgb * 0.667;
                c[9] = color4.rgb * 0.667;
                c[10] = color5.rgb * 0.667;
                c[11] = color6.rgb * 0.667;
                ncolors = 12;
            } else if( palette == 8 ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                c[4] = color5.rgb;
                c[5] = color6.rgb;
                ncolors = 6;
            } else if( palette == 9 && shades ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                c[4] = color5.rgb;
                c[5] = color6.rgb;
                c[6] = color7.rgb;
                c[7] = color8.rgb;

                c[8]  = color1.rgb * 0.667;
                c[9]  = color2.rgb * 0.667;
                c[10] = color3.rgb * 0.667;
                c[11] = color4.rgb * 0.667;
                c[12] = color5.rgb * 0.667;
                c[13] = color6.rgb * 0.667;
                c[14] = color7.rgb * 0.667;
                c[15] = color8.rgb * 0.667;
                ncolors = 16;
            } else if( palette == 9 ) {
                c[0] = color1.rgb;
                c[1] = color2.rgb;
                c[2] = color3.rgb;
                c[3] = color4.rgb;
                c[4] = color5.rgb;
                c[5] = color6.rgb;
                c[6] = color7.rgb;
                c[7] = color8.rgb;
                ncolors = 8;
            }

            vec3 bestColor = c[0];
            float bestDist = 100.0;

            for( int i=0; i<ncolors; i++ ) {
                float l = length(c[i] - rgb);
                if( l < bestDist ) {
                    bestDist = l;
                    bestColor = c[i];
                }
            }

            gl_FragColor = mix(texColor, vec4(bestColor,1.0) * a, alpha);
        }

    