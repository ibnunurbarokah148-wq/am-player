precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform float angle;
uniform float crop;
uniform float feather;
uniform float scale;
uniform float radius;
uniform float width;
uniform bool stretch;
uniform bool mirror;
uniform float repeat;
uniform vec2 position;



        vec4 getSample( float a, float r ) {
            a *= 1. - (0.5/acLayerSize.x);
            a += 0.5/acLayerSize.x;
            vec2 sampleCoord = vec2(a,r);
            sampleCoord = (vec4(sampleCoord,0.0,1.0) * acLayerToScreen).xy;
            return texture2DCv(inputImg,sampleCoord);
        }

        float smoothStep(float edge0, float edge1, float t) {
            if(edge0 == edge1) return 1.0;
            return smoothstep(edge0, edge1, t);
        }

        void main() {
            float rad = angle * 0.0174533;
            vec2 pos = acLayerNorm - 0.5;
            if(!stretch) {
                pos.x *= acLayerSize.x / acLayerSize.y;
            }
            pos /= scale;
            pos += (position*vec2(-1.0,1.0)) / 1000.0;
            float r = (length(pos)*2.0 - radius) / max(width,0.0000001);
            float a = mod(((atan(pos.y,pos.x)+rad)/6.28318)+0.5,1.0);
            a = mod(a * repeat,1.0);
            if(mirror) {
                a = abs(a * 2.0 - 1.0);
            }
            float cropFactor = (1.-(1./acLayerSize.x*(crop)));
            float featherFactor = (1.-(1./acLayerSize.x*(feather)));
            a = (a - 0.5) * featherFactor + 0.5;
            float featherDist = (1.0 - featherFactor);
            float f0 = smoothStep(0.0,featherDist,a);
            float f1 = smoothStep(1.0,1.0-featherDist,a);

            a = (a - 0.5) * cropFactor + 0.5;

            float cff = cropFactor * featherFactor;

            if( feather >= 0.0 && f0+f1 > 0.0 ) {
                gl_FragColor = mix( getSample(a+cff,r), mix( getSample(a-cff,r), getSample(a,r), f1 ), f0);
            } else {
                gl_FragColor = getSample(a,r);
            }

        }

    