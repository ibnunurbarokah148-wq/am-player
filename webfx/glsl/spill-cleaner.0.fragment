precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform sampler2D blurImg; uniform vec2 __sz_blurImg;
uniform sampler2D hstreak; uniform vec2 __sz_hstreak;
uniform sampler2D vstreak; uniform vec2 __sz_vstreak;
uniform float strength;


        
        vec4 sampleTex(vec2 uv) {
            if( acPass==1 ) {
                return texture2DCv(blurImg,uv);
            } else {
                return texture2DCv(hstreak,uv);
            }
        }
        
        vec4 xstreak() {
            float texelSize = 1.0 / acScreenSize.x;
            float dist = strength * 0.05;
            int nSamples = int(clamp(dist/texelSize,1.01,100.01));
            vec4 c = vec4(0.);
            for( int i=1; i<nSamples; i++ ) {
                float offset = dist * (float(i)/float(nSamples-1) - 0.5);
                vec2 sampleCoord = acScreenNorm + vec2(offset,0.);
                vec4 tc = sampleTex(sampleCoord);
                if( offset < 0. ) {
                    c = c * (1.-tc.a) + tc;
                } else {
                    c = tc * (1.-c.a) + c;
                }
            }
            return c;
        }
        
        vec4 ystreak() {
            float texelSize = 1.0 / acScreenSize.y;
            float dist = strength * 0.05;
            int nSamples = int(clamp(dist/texelSize,1.01,100.01));
            vec4 c = vec4(0.);
            for( int i=1; i<nSamples; i++ ) {
                float offset = dist * (float(i)/float(nSamples-1) - 0.5);
                vec2 sampleCoord = acScreenNorm + vec2(0.,offset);
                vec4 tc = sampleTex(sampleCoord);
                if( offset < 0. ) {
                    c = c * (1.-tc.a) + tc;
                } else {
                    c = tc * (1.-c.a) + c;
                }
            }
            return c;
        }
        
        vec4 composite( vec4 a, vec4 b) {
            return a * (1. - b.a) + b;
        }

        highp mat3 rgb2yuv = mat3(
             0.299,     0.587,    0.114,
            -0.14713,  -0.28886,  0.436,
             0.615,    -0.51499, -0.10001
        );
        highp mat3 yuv2rgb = mat3(
            1.0,  0.0,      1.13983,
            1.0, -0.39465, -0.58060,
            1.0,  2.03211,  0.0
        );

        void main() {
            if( acPass==1 || acPass==2 ) {
                vec4 c1 = xstreak();
                vec4 c2 = ystreak();
                vec4 blur = texture2DCv(blurImg, acScreenNorm);
                gl_FragColor = composite(composite(c1,c2),blur);
            } else {
                vec4 base = texture2DCv(inputImg, acScreenNorm);
                vec4 blur = texture2DCv(blurImg, acScreenNorm);
                vec4 streak = texture2DCv(vstreak, acScreenNorm);
                vec4 c = streak * saturate((1.-blur.a)*2.) * base.a;
                vec3 baseYUV = (base.rgb/max(0.00001,base.a)) * rgb2yuv;
                vec3 cYUV = (c.rgb/max(0.00001,c.a)) * rgb2yuv;
                cYUV.x = baseYUV.x;
                c = vec4(cYUV * yuv2rgb,1.) * c.a;
                gl_FragColor = composite(base,c);
            }
        }

    