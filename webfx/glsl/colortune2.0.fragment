precision highp float;
precision highp int;

varying vec2 acScreenNorm;   /* uv, y-up (GL convention) — AM: normalized screen coord */
#define   acLayerNorm        acScreenNorm

uniform vec2  acScreenSize;       /* render target px */
uniform vec2  acLayerSize;        /* layer px */
uniform vec2  acLayerCenter;      /* layer center px */
uniform vec2  acLayerCenterNorm;  /* layer center, normalized */
uniform vec2  acLayerPivot;       /* pivot offset px */
uniform vec2  acLayerSizeNorm;    /* layer size / screen size */
uniform vec2  acPreviewSize;      /* preview canvas px */
uniform vec2  acProjectSize;      /* project px */
uniform vec2  acVelocity;         /* per-frame translation */
uniform float acTime;             /* seconds */
uniform float acAngularVelocity;
uniform float acScaleVelocity;
uniform mat3  acScreenToLayer;
uniform mat3  acLayerToScreen;
uniform mat4  acLTS;
uniform bool  acShowGuides;
uniform int   acPass;

vec4  texture2DCv(sampler2D s, vec2 uv) { return texture2D(s, uv); }
vec2  getTexSize(vec2 sz)             { return sz; }
float saturate(float v)               { return clamp(v, 0.0, 1.0); }
vec2  saturate(vec2 v)                { return clamp(v, 0.0, 1.0); }
vec3  saturate(vec3 v)                { return clamp(v, 0.0, 1.0); }
vec4  saturate(vec4 v)                { return clamp(v, 0.0, 1.0); }


uniform sampler2D inputImg; uniform vec2 __sz_inputImg;
uniform vec3 lift;
uniform vec3 gamma;
uniform vec3 gain;
uniform vec3 offset;



        vec3 rotUV( vec3 yuv, float degrees ) {
            float rad = degrees * 0.0174533;
            highp mat3 rmat = mat3(
                1.0,  0.0,       0.0,
                0.0,  cos(rad),  sin(rad),
                0.0,  -sin(rad), cos(rad)
            );
            return yuv * rmat;
        }

        vec3 hsv2rgb(vec3 c)
        {
            vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
            vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
            return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
        }

        void main() {
            //float hue = lift.x;
            //float strength = lift.y;
            highp mat3 rgb2yuv = mat3(
                 0.299,     0.587,    0.114,
                -0.14713,  -0.28886,  0.436,
                 0.615,    -0.51499, -0.10001
            );
            highp mat3 yuv2rgb = mat3(
                1.0,  0.0,      1.13983,
                1.0, -0.39465, -0.58060,
                1.0,  2.03211,  0.0
            );

            vec4 texColor = texture2DCv(inputImg,acScreenNorm);
            highp vec3 rgb = texColor.rgb;
            lowp float a = texColor.a;
            highp vec3 yuv = rgb * rgb2yuv;

            highp vec3 liftYUV = (hsv2rgb(vec3(lift.x/360.,1.,0.5)) * rgb2yuv) * lift.y;
            highp vec3 gammaYUV = (hsv2rgb(vec3(gamma.x/360.,1.,0.5)) * rgb2yuv) * gamma.y;
            highp vec3 gainYUV = (hsv2rgb(vec3(gain.x/360.,1.,0.5)) * rgb2yuv) * gain.y;
            highp vec3 offsetYUV = (hsv2rgb(vec3(offset.x/360.,1.,0.5)) * rgb2yuv) * offset.y;

            // -- Do work here in YUV space ----

            float y = yuv.x;

            float ygamma = 1.-pow(abs((y-0.5)*2.),2.);

            yuv.yz += liftYUV.yz * ((1.-y)*(1.-y)) * a;
            yuv.x += ((1.-y)*(1.-y))*lift.z * a;
            yuv.yz += gammaYUV.yz * ygamma * a;
            yuv.x += gamma.z * ygamma * a;
            yuv.yz += gainYUV.yz * (y*y) * a;
            yuv.x += gain.z * (y*y) * a;
            yuv.yz += offsetYUV.yz * a;
            yuv.x += offset.z * a;

            // -- Back to RGB and return result ---
            rgb = yuv * yuv2rgb;
            gl_FragColor = vec4(rgb,a);
        }

    