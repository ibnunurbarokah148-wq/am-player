{
  "name": "am-xml-player",
  "version": "0.1.0",
  "description": "Native desktop previewer for Alight Motion scene XML projects",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.amxmlplayer.desktop",
    "productName": "AM XML Player",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "portable" }
  }
}
